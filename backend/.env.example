PORT=3000

# PostgreSQL (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OBLIGATOIRE en production
JWT_SECRET=

# Origines autorisées
CORS_ORIGINS=http://localhost:5173

# Dossier des images uploadées
UPLOAD_DIR=uploads

# URL publique du backend (laissez vide en dev)
PUBLIC_URL=

# Admin : crée ou promeut ce compte au démarrage
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Ne pas insérer de données demo en production
SEED_DEMO=false

# Brevo (email transactionnel)
BREVO_API_KEY=
FROM_EMAIL=no-reply@selline.cm
FROM_NAME=Selline
APP_URL=http://localhost:5173
